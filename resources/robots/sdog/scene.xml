<mujoco model="sdog scene">
  <include file="sdogHP.xml"/>

  <option cone="elliptic"/>

  <statistic center="1.0 0.7 0.6" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0.9 0.9 0.9"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-140" elevation="20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="flat" rgb1="0 0 0" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="1 0 3.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" contype="2" conaffinity="1" friction="1.25 0.005 0.0001"/>
  </worldbody>

  <actuator>
    <motor name="motor_FL_hip_joint" joint="FL_hip_joint" gear="1" ctrllimited="true" ctrlrange="-17 17" forcelimited="true" forcerange="-17 17"/>
    <motor name="motor_FL_thigh_joint" joint="FL_thigh_joint" gear="1" ctrllimited="true" ctrlrange="-17 17" forcelimited="true" forcerange="-17 17"/>
    <motor name="motor_FL_calf_joint" joint="FL_calf_joint" gear="1" ctrllimited="true" ctrlrange="-17 17" forcelimited="true" forcerange="-17 17"/>

    <motor name="motor_FR_hip_joint" joint="FR_hip_joint" gear="1" ctrllimited="true" ctrlrange="-17 17" forcelimited="true" forcerange="-17 17"/>
    <motor name="motor_FR_thigh_joint" joint="FR_thigh_joint" gear="1" ctrllimited="true" ctrlrange="-17 17" forcelimited="true" forcerange="-17 17"/>
    <motor name="motor_FR_calf_joint" joint="FR_calf_joint" gear="1" ctrllimited="true" ctrlrange="-17 17" forcelimited="true" forcerange="-17 17"/>

    <motor name="motor_RL_hip_joint" joint="RL_hip_joint" gear="1" ctrllimited="true" ctrlrange="-17 17" forcelimited="true" forcerange="-17 17"/>
    <motor name="motor_RL_thigh_joint" joint="RL_thigh_joint" gear="1" ctrllimited="true" ctrlrange="-17 17" forcelimited="true" forcerange="-17 17"/>
    <motor name="motor_RL_calf_joint" joint="RL_calf_joint" gear="1" ctrllimited="true" ctrlrange="-17 17" forcelimited="true" forcerange="-17 17"/>

    <motor name="motor_RR_hip_joint" joint="RR_hip_joint" gear="1" ctrllimited="true" ctrlrange="-17 17" forcelimited="true" forcerange="-17 17"/>
    <motor name="motor_RR_thigh_joint" joint="RR_thigh_joint" gear="1" ctrllimited="true" ctrlrange="-17 17" forcelimited="true" forcerange="-17 17"/>
    <motor name="motor_RR_calf_joint" joint="RR_calf_joint" gear="1" ctrllimited="true" ctrlrange="-17 17" forcelimited="true" forcerange="-17 17"/>
  </actuator>
</mujoco>